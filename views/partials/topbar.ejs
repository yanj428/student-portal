      <header class="topbar">
        <div class="user-block">
          <div class="user-info">
            <span class="user-name" id="user-name"><%= student.fullName %></span>
            <span class="user-meta" id="user-grade"><%= student.gradeLabel %></span>
          </div>
          <div class="avatar" id="user-avatar"><%= (student.firstName[0] || '') + (student.lastName[0] || '') %></div>
        </div>
      </header>
