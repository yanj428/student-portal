<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-links', { pageTitle: 'Clubs', pageCss: 'clubs.css' }) %>
</head>
<body>
  <div class="app">
<%- include('../partials/sidebar', { activePage: 'clubs' }) %>
    <main class="main">
<%- include('../partials/topbar', { student }) %>
      <section class="page-header">
        <h1>Clubs</h1>
        <p>Community service clubs and after school clubs, all in one place.</p>
      </section>

      <section class="clubs-section" id="community-service-clubs">
        <h2 class="club-section-title">Community Service Clubs</h2>
        <div class="club-grid" id="cs-clubs-list"></div>
        <p class="club-empty" id="cs-clubs-empty">No community service clubs have been added yet.</p>
      </section>

      <section class="clubs-section" id="after-school-clubs">
        <h2 class="club-section-title">After School Clubs</h2>
        <div class="club-grid" id="clubs-page-list"></div>
        <p class="club-empty" id="clubs-page-empty">No clubs have been added yet. Check back soon.</p>
      </section>

      <dialog class="club-dialog" id="club-dialog" aria-labelledby="club-dialog-title">
        <button type="button" class="club-dialog-close" id="club-dialog-close" aria-label="Close">&times;</button>
        <div id="club-dialog-body"></div>
      </dialog>
    </main>
  </div>

  <script src="common.js"></script>
  <script src="clubs.js"></script>
</body>
</html>
