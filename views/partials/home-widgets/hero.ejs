<section class="home-hero">
        <div class="home-hero-text">
<% if (options.showDate) { %>
          <span class="home-hero-date" id="today-date"></span>
<% } %>
          <h1 id="welcome-heading">Welcome back, <%= student.firstName %>!</h1>
<% if (options.showButtons && options.buttons.length) { %>
          <div class="home-hero-actions" data-sortable="hero">
<% options.buttons.forEach(function (id, i) { var b = id === 'slide' ? { href: '/announcements', title: "This week's slide", icon: navItems.announcements.icon } : navItems[id]; if (!b) return; %>
            <a class="home-pill <%= i === 0 ? 'home-pill-light' : 'home-pill-outline' %>" href="<%= b.href %>"<% if (id === 'slide') { %> id="hero-slide-link"<% } %> data-item-id="<%= id %>"><%- b.icon %> <%= b.title %></a>
<% }); %>
          </div>
<% } %>
        </div>
<% if (options.showCrest) { %>        <div class="home-hero-crest">
          <img src="assets/kpis-logo.png" alt="KPIS International School crest" />
        </div>
<% } %>
      </section>
