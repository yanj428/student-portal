<section>
        <div class="home-section-head"><h2>Jump to</h2></div>
        <div class="home-tiles" data-sortable="jump">
<% options.tiles.forEach(function (id) { var tile = navItems[id]; if (!tile) return; %>
          <a class="home-tile" href="<%= tile.href %>" data-item-id="<%= id %>">
            <span class="home-tile-icon"><%- tile.icon %></span>
            <%= tile.title %>
          </a>
<% }); %>
        </div>
      </section>