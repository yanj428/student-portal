<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-links', { pageTitle: 'Lunch Schedule', pageCss: 'lunch-schedule.css' }) %>
</head>
<body>
  <div class="app">
<%- include('../partials/sidebar', { activePage: 'lunch-schedule' }) %>
    <main class="main">
<%- include('../partials/topbar', { student }) %>


      <section class="page-header">
        <h1>Lunch Schedule</h1>
        <p>This week's menu, updated weekly by admin.</p>
      </section>

      <section class="lunch-card">
        <div class="lunch-card-head">
          <h2>This Week's Menu</h2>
          <span class="week-label" id="week-label" hidden></span>
        </div>
        <div class="lunch-image-wrap" id="lunch-image-wrap" hidden>
          <img id="lunch-image" src="" alt="This week's lunch menu" />
          <iframe id="lunch-pdf" class="lunch-pdf" title="This week's lunch menu" hidden></iframe>
        </div>
        <a class="lunch-pdf-link" id="lunch-pdf-link" href="#" target="_blank" rel="noopener" hidden>Open the menu in a new tab</a>
        <p class="lunch-empty" id="lunch-empty">No menu has been posted yet this week. Check back soon.</p>
      </section>

      <section class="lunch-archive-section">
        <h2 class="archive-heading">Looking for a past week?</h2>
        <a class="archive-drive-link" href="https://drive.google.com/drive/u/0/folders/1eZqMhCzEj1wrBtKgsDVc-CL-c1zZwyjj" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none"><path d="M4 5C4 3.9 4.9 3 6 3H18C19.1 3 20 3.9 20 5V19C20 20.1 19.1 21 18 21H6C4.9 21 4 20.1 4 19V5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8H16M8 12H16M8 16H12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <span>Browse the lunch menu archive on Google Drive</span>
          <svg class="archive-drive-arrow" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </section>

    </main>
  </div>

  <script src="common.js"></script>
  <script src="lunch-schedule.js"></script>
</body>
</html>
