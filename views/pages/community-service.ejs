<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-links', { pageTitle: 'Community Service', pageCss: 'community-service.css' }) %>
  <link rel="stylesheet" href="service-hours.css" />
</head>
<body>
  <div class="app">
<%- include('../partials/sidebar', { activePage: 'community-service' }) %>
    <main class="main">
<%- include('../partials/topbar', { student }) %>


      <section class="page-header">
        <h1>Community Service</h1>
        <p><span class="cs-grades">Grades 9&ndash;12</span></p>
      </section>

<% if (student.csCoordinator) { %>
      <a class="hrs-review-link" href="/service-hours">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11L11 13L15 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/></svg>
        <span><strong>Review student hours</strong><small>Approve logged hours, see each student's progress and download a spreadsheet.</small></span>
        <svg class="hrs-review-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
<% } %>
      <nav class="cs-tabs" role="tablist" aria-label="Community service sections">
<% if (logsHours) { %>
        <button type="button" role="tab" class="cs-tab" id="cs-tab-log" data-tab="log" aria-selected="true">Log hours</button>
<% } %>
        <button type="button" role="tab" class="cs-tab" id="cs-tab-events" data-tab="events" aria-selected="<%= logsHours ? 'false' : 'true' %>">Events</button>
        <button type="button" role="tab" class="cs-tab" id="cs-tab-info" data-tab="info" aria-selected="false">Information</button>
      </nav>

<% if (logsHours) { %>
      <section class="cs-panel" id="cs-panel-log" role="tabpanel" aria-labelledby="cs-tab-log">
        <div class="cs-top">
          <section class="hrs-card" id="hrs-card">
            <div class="hrs-head">
              <div class="hrs-summary">
                <h2 class="cs-label">My service hours</h2>
                <p class="hrs-total"><strong id="hrs-approved">0</strong> <span id="hrs-total-text">of 100 hours to graduate</span></p>
              </div>
              <a class="hrs-btn primary" href="/service-report" id="hrs-log-btn">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                Log hours
              </a>
            </div>
            <div class="hrs-progress" id="hrs-progress" role="progressbar" aria-label="Progress toward the hours needed to graduate" aria-valuemin="0" aria-valuemax="100"><div class="hrs-progress-bar" id="hrs-progress-bar"></div></div>
            <div class="hrs-year">
              <p class="hrs-year-text" id="hrs-year-text"></p>
              <div class="hrs-progress hrs-progress-thin" id="hrs-year-progress" role="progressbar" aria-label="Progress toward this school year's recommended hours" aria-valuemin="0" aria-valuemax="100"><div class="hrs-progress-bar" id="hrs-year-bar"></div></div>
            </div>
            <p class="hrs-pending" id="hrs-pending" hidden></p>
          </section>

          <section class="hrs-card hrs-running" aria-labelledby="hrs-running-label">
            <h2 class="cs-label" id="hrs-running-label">Running totals</h2>
            <table class="hrs-grades">
              <thead><tr><th scope="col">Grade</th><th scope="col">Hours</th></tr></thead>
              <tbody id="hrs-grades"></tbody>
              <tfoot><tr><th scope="row">Grand total</th><td id="hrs-grand">0</td></tr></tfoot>
            </table>
          </section>
        </div>

        <section class="hrs-card hrs-activities">
          <div class="hrs-activities-head">
            <h2 class="cs-label">Past activities</h2>
            <div class="hrs-filters" id="hrs-filters" role="group" aria-label="Filter activities">
              <button type="button" class="hrs-chip on" data-filter="all" aria-pressed="true">All</button>
              <button type="button" class="hrs-chip" data-filter="year" aria-pressed="false">This year</button>
              <button type="button" class="hrs-chip" data-filter="pending" aria-pressed="false">Pending</button>
            </div>
          </div>
          <div class="hrs-cols" aria-hidden="true"><span>Date</span><span>Grade</span><span>Activity</span><span>Hours</span><span>Staff name</span><span>Status</span><span>Admin initials</span></div>
          <div class="hrs-list" id="hrs-list"></div>
          <p class="hrs-empty" id="hrs-empty" hidden>No reports yet. Press Log hours after each service project to fill in your project report.</p>
          <button type="button" class="hrs-more" id="hrs-more" hidden></button>
        </section>
      </section>
<% } %>

      <section class="cs-panel" id="cs-panel-events" role="tabpanel" aria-labelledby="cs-tab-events"<% if (logsHours) { %> hidden<% } %>>
        <section class="cs-events-section" id="cs-events-section">
            <h2 class="cs-heading">Open opportunities</h2>
            <div class="cs-events-list" id="cs-events-list"></div>
            <div class="cs-events-empty" id="cs-events-empty">
              <span class="cs-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 9H21M8 2V5M16 2V5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
              <span>Nothing posted right now. Clubs add volunteer opportunities here, so check back soon.</span>
            </div>
        </section>
      </section>

      <section class="cs-panel" id="cs-panel-info" role="tabpanel" aria-labelledby="cs-tab-info" hidden>
        <div class="cs-rail">
          <section class="cs-toolkit cs-resources">
            <h2 class="cs-label">Toolkit</h2>
            <div class="resource-list" id="cs-resources-list"></div>
            <p class="cs-events-empty" id="cs-resources-empty" hidden>No resources have been posted yet.</p>
          </section>

          <a class="cs-join" href="/clubs#community-service-clubs">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 19C3.5 15.9 6 14 9 14C12 14 14.5 15.9 14.5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16 5.5C17.7 5.8 19 7.2 19 9C19 10.5 18.2 11.7 17 12.3M17.5 14.3C19.6 14.9 21 16.5 21 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <strong>Join a club</strong>
            <span>See community service clubs and how to join.</span>
          </a>

          <a class="cs-idea" href="https://www.un.org/sustainabledevelopment/" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M3 12H21M12 3C14.5 5.5 14.5 18.5 12 21M12 3C9.5 5.5 9.5 18.5 12 21" stroke="currentColor" stroke-width="1.8"/></svg>
            <span>Need an idea? Browse the UN global goals</span>
          </a>
        </div>
      </section>
    </main>
  </div>

  <script src="common.js"></script>
  <script src="community-service.js"></script>
<% if (logsHours) { %>
  <script src="hours-shared.js"></script>
  <script src="cs-hours.js"></script>
<% } %>
</body>
</html>
