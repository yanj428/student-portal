<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-links', { pageTitle: 'Student Voice', pageCss: 'voice.css' }) %>
</head>
<body>
  <div class="app">
<%- include('../partials/sidebar', { activePage: 'student-voice' }) %>
    <main class="main">
<%- include('../partials/topbar', { student }) %>


      <section class="voice-header">
        <h1>Student Voice</h1>
        <p>Share suggestions, concerns, or questions directly with the Student Council. Only StuCo sees what you submit.</p>
      </section>

      <section class="composer">
        <h2 class="composer-title" id="composer-title">Share something</h2>
        <form id="post-form">
          <label class="field-label" for="post-title">Title</label>
          <input class="field-input" type="text" id="post-title" placeholder="Sum it up in a few words" maxlength="120" required />

          <label class="field-label" for="post-category">Category</label>
          <select class="field-input" id="post-category" required>
            <option value="" disabled selected>Select a category</option>
            <option value="Suggestion">Suggestion</option>
            <option value="Concern">Concern</option>
            <option value="Question">Question</option>
            <option value="Shoutout">Shoutout</option>
            <option value="Other">Other</option>
          </select>

          <label class="field-label" for="post-input">Message</label>
          <textarea id="post-input" class="composer-input" placeholder="Share the details…" maxlength="2000" required></textarea>

          <div class="composer-footer">
            <span class="composer-hint" id="composer-hint">Only StuCo can see what you submit — other students never will.</span>
            <div class="composer-buttons">
              <button type="button" class="btn ghost" id="post-cancel" hidden>Cancel</button>
              <button type="submit" class="btn primary" id="post-submit">Submit</button>
            </div>
          </div>
          <p class="field-error" id="post-error" hidden></p>
        </form>
      </section>

      <h2 class="section-title">My Suggestions</h2>
      <section class="voice-feed" id="voice-feed">
        <p class="feed-empty" id="feed-empty" hidden>You haven't submitted anything yet.</p>
      </section>

    </main>
  </div>

  <script src="script.js"></script>
  <script src="voice.js"></script>
</body>
</html>
