<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-links', { pageTitle: 'School Calendar', pageCss: 'school-calendar.css' }) %>
</head>
<body>
  <div class="app">
<%- include('../partials/sidebar', { activePage: 'school-calendar' }) %>
    <main class="main">
<%- include('../partials/topbar', { student }) %>


      <section class="page-header">
        <h1>School Calendar</h1>
        <p>The school calendar for the whole school year.</p>
      </section>

      <section class="calendar-image-card" id="calendar-image-card" hidden>
        <h2 class="section-heading" id="calendar-image-label">School year calendar</h2>
        <a id="calendar-image-link" href="#" target="_blank" rel="noopener" title="Open the full size calendar">
          <img id="calendar-image" alt="School calendar for the school year" />
        </a>
        <p class="calendar-image-hint">Tap or click the calendar to open it full size.</p>
      </section>
      <p class="calendar-image-empty" id="calendar-image-empty">The school calendar hasn't been posted yet. Check back soon.</p>

    </main>
  </div>

  <script src="common.js"></script>
  <script src="school-calendar.js"></script>
</body>
</html>
