    <%
      const svg = (inner) => `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">${inner}</svg>`;
      const S = 'stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
      const icons = {
        home: svg(`<path d="M3 11L12 4L21 11" ${S}/><path d="M5 9.5V20C5 20.6 5.4 21 6 21H18C18.6 21 19 20.6 19 20V9.5" ${S}/><path d="M9.5 21V14C9.5 13.4 9.9 13 10.5 13H13.5C14.1 13 14.5 13.4 14.5 14V21" ${S}/>`),
        announcements: svg(`<path d="M3 10V14C3 14.6 3.4 15 4 15H6.5L13 19V5L6.5 9H4C3.4 9 3 9.4 3 10Z" ${S}/><path d="M17.5 9.5C18.5 10.6 18.5 13.4 17.5 14.5" ${S}/><path d="M20 7C22 9.5 22 14.5 20 17" ${S}/>`),
        events: svg(`<rect x="3" y="4" width="18" height="17" rx="2" ${S}/><path d="M3 9H21" ${S}/><path d="M8 2V5M16 2V5" ${S}/><path d="M9 15L11 17L15 13" ${S}/>`),
        lunch: svg(`<path d="M6 3V11" ${S}/><path d="M4 3V8C4 9.1 4.9 10 6 10C7.1 10 8 9.1 8 8V3" ${S}/><path d="M6 11V21" ${S}/><path d="M18 3C15.8 3 14 5.5 14 8.5C14 10.5 15 11 15.5 11.5C16 12 16 12.5 16 13V21" ${S}/>`),
        more: svg(`<rect x="4" y="4" width="6.5" height="6.5" rx="1.6" ${S}/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6" ${S}/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6" ${S}/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6" ${S}/>`),
        clubs: svg(`<path d="M12 3L14.5 8.5L20.5 9.2L16 13.2L17.3 19.2L12 16L6.7 19.2L8 13.2L3.5 9.2L9.5 8.5L12 3Z" ${S}/>`),
        service: svg(`<path d="M12 21C12 21 4 15.5 4 9.8C4 7.1 6.1 5 8.7 5C10 5 11.2 5.6 12 6.6C12.8 5.6 14 5 15.3 5C17.9 5 20 7.1 20 9.8C20 15.5 12 21 12 21Z" ${S}/>`),
        voice: svg(`<path d="M4 5C4 3.9 4.9 3 6 3H18C19.1 3 20 3.9 20 5V13C20 14.1 19.1 15 18 15H9L5 19V15H6C4.9 15 4 14.1 4 13V5Z" ${S}/>`),
        calendar: svg(`<rect x="3" y="4" width="18" height="17" rx="2" ${S}/><path d="M3 9H21" ${S}/><path d="M8 2V5M16 2V5" ${S}/>`),
        links: svg(`<path d="M9.5 14.5L14.5 9.5" ${S}/><path d="M11 7.5L12.2 6.3C13.5 5 15.6 5 16.9 6.3C18.2 7.6 18.2 9.7 16.9 11L15.7 12.2" ${S}/><path d="M13 16.5L11.8 17.7C10.5 19 8.4 19 7.1 17.7C5.8 16.4 5.8 14.3 7.1 13L8.3 11.8" ${S}/>`),
        council: svg(`<circle cx="8.5" cy="8" r="3" ${S}/><circle cx="17" cy="9.5" r="2.3" ${S}/><path d="M3 20C3 16.7 5.5 14 8.5 14C11.5 14 14 16.7 14 20" ${S}/><path d="M14.5 14.3C17.2 14.6 19.3 16.9 19.3 19.7" ${S}/>`),
        logout: svg(`<path d="M9 21H5C4.4 21 4 20.6 4 20V4C4 3.4 4.4 3 5 3H9" ${S}/><path d="M16 17L21 12L16 7" ${S}/><path d="M21 12H9" ${S}/>`),
      };
      const main = [
        ['home', '/', 'Home', icons.home],
        ['announcements', '/announcements', 'News', icons.announcements],
        ['upcoming-events', '/upcoming-events', 'Events', icons.events],
        ['lunch-schedule', '/lunch-schedule', 'Lunch', icons.lunch],
      ];
      const groups = [
        ['Get involved', [
          ['clubs', '/clubs', 'Clubs', icons.clubs],
          ['community-service', '/community-service', 'Community service', icons.service],
          ['student-voice', '/student-voice', 'Student voice', icons.voice],
        ]],
        ['School info', [
          ['school-calendar', '/school-calendar', 'School calendar', icons.calendar],
          ['quick-links', '/quick-links', 'Quick links', icons.links],
          ['meet-council', '/meet-council', 'Meet your council', icons.council],
        ]],
      ];
      const inMore = groups.some(([, items]) => items.some(([id]) => id === activePage));
    %>
    <!-- Phone navigation: a labelled bar along the bottom, plus a sheet for the other pages -->
    <nav class="tabbar" aria-label="Main">
      <% main.forEach(([id, href, label, icon]) => { %>
        <a href="<%= href %>" class="tab<%= activePage === id ? ' active' : '' %>"<%- activePage === id ? ' aria-current="page"' : '' %>><span class="tab-icon"><%- icon %></span><span class="tab-label"><%= label %></span></a>
      <% }) %>
      <button type="button" class="tab<%= inMore ? ' active' : '' %>" id="more-btn" aria-expanded="false" aria-controls="more-sheet"><span class="tab-icon"><%- icons.more %></span><span class="tab-label">More</span></button>
    </nav>
    <div class="more-backdrop" id="more-backdrop" hidden></div>
    <div class="more-sheet" id="more-sheet" role="dialog" aria-label="More pages" hidden>
      <div class="more-grab" aria-hidden="true"></div>
      <% groups.forEach(([title, items]) => { %>
        <p class="more-group"><%= title %></p>
        <div class="more-grid">
          <% items.forEach(([id, href, label, icon]) => { %>
            <a href="<%= href %>" class="more-item<%= activePage === id ? ' active' : '' %>"<%- activePage === id ? ' aria-current="page"' : '' %>><%- icon %><span><%= label %></span></a>
          <% }) %>
        </div>
      <% }) %>
      <a href="#" class="more-logout js-logout"><%- icons.logout %><span>Log out</span></a>
    </div>
