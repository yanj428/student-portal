PORT=8791
# Password for the first admin account. Edit it here and restart the server to
# change it - there is no change-password screen in the admin panel.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Set these two when the site is actually reachable outside your own
# machine (a real deployment, or even a temporary public tunnel).
# NODE_ENV=production turns on secure (HTTPS-only) cookies and refuses to
# start with the default ADMIN_PASSWORD/SESSION_SECRET above.
# TRUST_PROXY tells Express it's behind a reverse proxy/tunnel, so it reads
# the real visitor IP (and can tell they're on HTTPS) instead of treating
# every visitor as the proxy itself — without it, the login rate limiter
# sees every visitor as one IP and can lock everyone out together.
# NODE_ENV=production
# TRUST_PROXY=1

# Optional overrides. Everything below has a sensible default.
# DATA_DIR=./data                 where portal.db lives (tests set this; a real
#                                 deployment can too, to keep data off the repo)
# BACKUP_DIR=./backups            where `npm run backup` writes copies
# BACKUP_KEEP_DAILY=14            how many of the newest backups to keep
# ADMIN_BOOTSTRAP_USERNAME=admin  username of the first admin account
# STUDENT_SESSION_IDLE_MINUTES / STUDENT_SESSION_ABSOLUTE_MINUTES
# ADMIN_SESSION_IDLE_MINUTES / ADMIN_SESSION_ABSOLUTE_MINUTES
# STUDENT_LOGIN_RATE_LIMIT, ADMIN_LOGIN_RATE_LIMIT, PASSWORD_CHANGE_RATE_LIMIT,
# VOICE_POST_RATE_LIMIT, CALENDAR_AI_RATE_LIMIT   (requests per window)

# Optional. Powers "Extract events with AI" on the School Calendar admin
# page (a Gemini API key from https://aistudio.google.com/apikey, free
# tier). Leave unset and that one feature just shows a clear "not set up"
# error - nothing else in the app depends on it.
GEMINI_API_KEY=
