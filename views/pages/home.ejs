<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head-links', { pageTitle: 'Student Portal' }) %>
</head>
<body>
  <div class="app">
<%- include('../partials/sidebar', { activePage: 'home' }) %>
    <main class="main" id="home-main">
<%- include('../partials/topbar', { student }) %>

      <div class="home-edit-bar" id="home-edit-bar" hidden>
        <p>Editing your home page. Drag a section by its handle to move it, or use Hide and Show. Only you see your changes.</p>
        <span class="home-edit-error" id="home-edit-error" hidden></span>
        <button type="button" class="home-edit-save" id="home-edit-save">Save</button>
        <button type="button" class="home-edit-secondary" id="home-edit-cancel">Cancel</button>
        <button type="button" class="home-edit-secondary" id="home-edit-reset">Reset to default</button>
      </div>

<% var widgetTitles = {}; homeWidgets.forEach(function (w) { widgetTitles[w.id] = w.title; }); %>
<% homeLayout.order.forEach(function (widgetId) { var isHidden = homeLayout.hidden.indexOf(widgetId) !== -1; %>
      <% var options = homeLayout.settings[widgetId]; %>
      <div class="home-widget<%= isHidden ? ' is-hidden' : '' %>" data-widget="<%= widgetId %>" data-title="<%= widgetTitles[widgetId] %>" data-settings="<%= JSON.stringify(options) %>">
<%- include('../partials/home-widgets/' + widgetId, { options: options }) %>
      </div>
<% if (widgetId === 'hero') { %>
      <div class="home-customize-bar">
        <button type="button" class="home-customize-btn" id="home-customize-btn">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7H14M18 7H20M4 17H6M10 17H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="16" cy="7" r="2" stroke="currentColor" stroke-width="1.8"/><circle cx="8" cy="17" r="2" stroke="currentColor" stroke-width="1.8"/></svg>
          Customize home page
        </button>
      </div>
<% } %>
<% }) %>
<% if (homeLayout.hidden.length === homeLayout.order.length) { %>
      <p class="home-empty home-all-hidden">Everything is hidden. Use "Customize home page" to bring it back.</p>
<% } %>
    </main>
  </div>

  <script src="common.js"></script>
  <script src="home.js"></script>
  <script src="home-customize.js"></script>
</body>
</html>
